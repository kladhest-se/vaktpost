.DS_Store

# Generated by `make project` / xcodegen. Never committed: an .xcodeproj names
# your paths and your team id, and its diffs are unreadable. project.yml is the
# checked-in source of truth.
*.xcodeproj
*.xcworkspace

# Build products
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# `.xcarchive`s from `make archive`. Rebuilt fresh each time — nothing in here
# is source.
build/

# The build counter, bumped by `make build` and `make archive`.
#
# Per machine, not per project: a build number here means "the nth build I have
# made on this Mac". Committing it would make every build produce a diff, and
# two people building the same commit would disagree about which build it is.
build.number
