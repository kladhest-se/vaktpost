#include "Shared.xcconfig"

IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO

// Mac distribution is deliberately disabled for 1.0.0. The iPad build has
// not completed its separate Apple Silicon Mac validation pass, so it must
// not appear as a Designed for iPad app. App Store Connect's corresponding
// Pricing and Availability checkbox must also remain off.
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// Stated explicitly. An xcconfig applied at project level can leave this empty
// for the scheme's buildables, which xcodebuild reports as
//
//   IDERunDestination: Supported platforms for the buildables in the current
//   scheme is empty.
//
// It is a warning rather than a failure, and it resolves to something workable,
// but a run destination chosen by fallback is not one worth relying on.
SUPPORTED_PLATFORMS = iphoneos iphonesimulator

// arm64 only, on device and in the simulator. A generic simulator destination
// otherwise builds an x86_64 slice that nothing here can run, and `make build`
// pays for it on every publish check.
ARCHS[sdk=iphoneos*] = arm64
ARCHS[sdk=iphonesimulator*] = arm64

// The version people see, and the build behind it.
//
// This reads the number of the *next* release from the moment work on it
// starts, so while 0.2.0 is being built this says 0.2.0 and CHANGELOG.md's top
// heading says `0.2.0 — Unreleased`. The heading takes a date when the archive
// goes up. A development build and a released build therefore never share a
// version, which is the point: a screenshot says which one it came from.
//
// Not bumped per build — that is what the build number is for.
//
// The 1 below is the fallback for a build started from Xcode rather than from
// make. It is deliberately not a plausible number: `make build` and
// `make archive` both override it from the counter in build.number, so a real
// build never shows 1.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Icons.
//
// The alternates are asset catalog icon sets rather than loose bundle files.
// Xcode generates the CFBundleIcons entries from these two settings and puts
// the images where the runtime expects them; hand-placed files were landing
// somewhere `setAlternateIconName` could not see, which reported "The file
// doesn't exist".
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES = AppIcon-ocean AppIcon-mint AppIcon-amber AppIcon-lavender AppIcon-silver
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = YES
