// Settings shared by the app and its test target.
//
// Build settings live here rather than in project.yml so that a value can be
// read by something other than XcodeGen — the Makefile reads MARKETING_VERSION
// out of iOS.xcconfig to print "1.0.0 (7)" after a build, and an .xcconfig is
// a file both a human and an awk one-liner can follow.

CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
SWIFT_TREAT_WARNINGS_AS_ERRORS[config=Release] = YES
GCC_TREAT_WARNINGS_AS_ERRORS = NO
GCC_TREAT_WARNINGS_AS_ERRORS[config=Release] = YES

// Swift 6 language mode with complete concurrency checking. Shared callback
// and trust state use compiler-known synchronization, while UIKit and refresh
// bookkeeping stay explicitly on the main actor. Release builds treat any
// future warning as an error above.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// No analytics or crash-reporting SDK is linked, so symbols stay local and
// crashes are triaged from a device log rather than a service.
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
